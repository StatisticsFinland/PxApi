{
  "RootUrl": "http://localhost:5080/",
  "Urls": "http://localhost:5080",
  "AllowedHosts": "localhost;127.0.0.1",
  "FeatureManagement": {
    "CacheController": true,
    "SearchController": false
  },
  "Localization": {
    "DefaultLanguage": "en",
    "SupportedLanguages": [ "en" ]
  },
  "DataBases": [
    {
      "Id": "sample",
      "Type": "Mounted",
      "CacheConfig": {
        "TableList": {
          "SlidingExpirationSeconds": 300,
          "AbsoluteExpirationSeconds": 1800
        },
        "Meta": {
          "SlidingExpirationSeconds": 300,
          "AbsoluteExpirationSeconds": 3600
        },
        "Data": {
          "SlidingExpirationSeconds": 120,
          "AbsoluteExpirationSeconds": 1200
        },
        "RevalidationIntervalMs": 1000
      },
      "Custom": {
        "RootPath": "SampleDatabases"
      }
    }
  ],
  "Cache": {
    "MaxSizeBytes": 16777216
  },
  "QueryLimits": {
    "JsonMaxCells": 1000,
    "JsonStatMaxCells": 1000
  },
  "Authentication": {
    "Cache": { "Key": "" },
    "Databases": { "Key": "" },
    "Tables": { "Key": "" },
    "Metadata": { "Key": "" },
    "Data": { "Key": "" },
    "Search": { "Key": "" },
    "Health": { "Key": "" }
  },
  "OpenApi": {
    "ContactName": "Sample API",
    "ContactUrl": "https://example.invalid/",
    "ContactEmail": "",
    "LicenseName": "",
    "LicenseUrl": ""
  },
  "LogOptions": {
    "Folder": "../agent_tmp/sample-database-testing/manual",
    "SysId": "PxApi",
    "Level": "Debug",
    "AuditLog": {
      "Enabled": false,
      "Headers": []
    }
  },
  "ApplicationInsights": {
    "Enabled": false,
    "ConnectionString": ""
  },
  "Search": {
    "CloudId": "",
    "IndexPrefix": "",
    "ProxyAddress": ""
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
