{
  "RootUrl": "Root url here, use localhost for local development.",
  "AllowedHosts": "*",
  "Cache": {
    "MaxSizeBytes": 2147483648,
    "DefaultDataCellSize": 16,
    "DefaultUpdateTaskSize": 50,
    "DefaultFileListSize": 350000,
    "DefaultMetaSize": 200000,
    "DefaultAliasSize": 256
  },
  "FeatureManagement": {
    "CacheController": false,
    "SearchController": false
  },
  "QueryLimits": {
    "JsonMaxCells": 100000,
    "JsonStatMaxCells": 50000
  },
  "Localization": {
    "DefaultLanguage": "en",
    "SupportedLanguages": [ "en" ]
  },
  "DataBases": [
    {
      "Id": "<DBName>",
      "Type": "BinaryBlobStorage",
      "CacheConfig": {
        "TableList": {
          "SlidingExpirationSeconds": 300,
          "AbsoluteExpirationSeconds": 1800
        },
        "Meta": {
          "SlidingExpirationSeconds": 300,
          "AbsoluteExpirationSeconds": 3600
        },
        "Data": {
          "SlidingExpirationSeconds": 120,
          "AbsoluteExpirationSeconds": 1200
        },
        "RevalidationIntervalMs": 10000
      },
      "Custom": {
        "ContainerName": "<ContainerName>",
        "StoragePath": "<StoragePath>"
      }
    }
  ],
  "OpenApi": {
    "ContactName": "<ContactName>",
    "ContactUrl": "<ContactUrl>",
    "ContactEmail": "<ContactEmail>",
    "LicenseName": "<LicenseName>",
    "LicenseUrl": "<LicenceUrl>"
  },
  "LogOptions": {
    "Folder": "Logs",
    "SysId": "PxApi",
    "Level": "Debug",
    "AuditLog": {
      "Enabled": true,
      "Headers": []
    }
  },
  "ApplicationInsights": {
    "MinimumLevel": "Debug",
    "EnableAdaptiveSampling": false
  },
  "Search": {
    "CloudId": "<ElasticCloudId>",
    "IndexPrefix": "<IndexPrefix>",
    "ProxyAddress": ""
  },
  "Cors": {
    "AllowedOrigins": []
  }
}