<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 autoReload="true"
 internalLogLevel="Info"
 internalLogFile="${basedir}/Logs/internal-nlog-AspNetCore.txt">
	<extensions>
		<add assembly="NLog.Web.AspNetCore" />
	</extensions>

	<!-- Use colon-separated keys for Microsoft configuration -->
	<variable name="logsPath" value="${configsetting:item=LogOptions.Folder}" />
	<variable name="textLogEnabled" value="${when:when='${configsetting:item=LogOptions.Folder}'!='':inner=true:else=false}" />
	<variable name="auditEnabled" value="${configsetting:item=LogOptions.AuditLog.Enabled:default=false}" />
	<variable name="consoleEnabled" value="${when:when='${environment:ASPNETCORE_ENVIRONMENT}'=='Development':inner=true:else=false}" />

	<targets>
		<!-- Regular application logs -->
		<target xsi:type="File" name="own" filename="${var:logsPath}/nlog-${shortdate}.log">
			<layout xsi:type="JsonLayout" includeAllProperties="true" includeScopeProperties="true" maxRecursionLimit="10" indentJson="true">
				<attribute name="Sysid" layout="${configsetting:item=LogOptions.SysId}" />
				<attribute name="Status" layout="${environment:ASPNETCORE_ENVIRONMENT}" />
				<attribute name="Datetime" layout="${longdate}" />
				<attribute name="Descr" layout="${message}" />
				<attribute name="Exception" layout="${exception:format=ToString}" />
				<attribute name="Level" layout="${level:upperCase=true}" />
			</layout>
		</target>

		<!-- Console output for local development -->
		<target xsi:type="Console" name="console"
			layout="${longdate}|${level:upperCase=true}|${logger:shortName=true}|${message}${onexception:inner= ${exception:format=ToString}}" />

		<!-- Dedicated target for audit logs -->
		<target xsi:type="File" name="audit" filename="${var:logsPath}/audit-${shortdate}.log">
			<layout xsi:type="JsonLayout" includeAllProperties="true" includeScopeProperties="true" maxRecursionLimit="10" indentJson="true">
				<attribute name="Sysid" layout="${configsetting:item=LogOptions.SysId}" />
				<attribute name="Datetime" layout="${longdate}" />
				<attribute name="Method" layout="${aspnet-request-method}" />
				<attribute name="Path" layout="${aspnet-request-url}" />
			</layout>
		</target>
	</targets>

	<rules>
		<!-- Skip Microsoft and System logs early -->
		<logger name="Microsoft.*" maxlevel="Fatal" final="true" />
		<logger name="System.Net.Http.*" maxlevel="Fatal" final="true" />

		<!-- Audit logs go to the audit target (correct namespace) -->
		<logger name="PxApi.Services.AuditLogService" minlevel="Info" writeTo="audit" enabled="${when:when='${auditEnabled}'=='true'}" final="true" />
		
		<!-- Console output for local development -->
		<logger name="*" minlevel="Debug" writeTo="console" enabled="${when:when='${consoleEnabled}'=='true'}" />

		<!-- All other application logs go to file target -->
		<logger name="*" minlevel="${configsetting:item=LogOptions.Level}" writeTo="own" enabled="${when:when='${textLogEnabled}'=='true'}" final="true" />
	</rules>
</nlog>